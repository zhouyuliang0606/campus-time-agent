# ===== 密钥和本地环境，绝不提交到 git =====
.env
.env.local

# ===== Python 缓存/虚拟环境 =====
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ===== 编辑器/系统垃圾 =====
.idea/
.vscode/
.DS_Store

# ===== 运行时自动生成的数据（学生消息/通知/人格，启动后由 app/store.py 创建） =====
app/data/student_messages.json
app/data/notices.json
# persona.json：管理员在后台配的客服人格，属运行时数据，不入库。
# 默认值写在 app/store.py 的 DEFAULT_PERSONA 里，删掉该文件就自动回到默认值。
app/data/persona.json

# ===== 敏感：管理台在线填的大模型密钥 =====
# settings.json 里可能有真实 API Key，一旦入库就是事故，务必排除。
# 密钥应该走 .env（本地）或 secrets manager（生产），这里只是演示的便利通道。
app/data/settings.json

# ===== 用户上传的文件（可能含私人资料，也不该进 git） =====
app/data/uploads.json
app/data/uploads/

# ===== 学生个人库（周表/待办/会话历史，全是个人隐私到校资料） =====
app/data/student/
# 待确认提案暂存：app/agent/pending.py 运行时自动生成的 ephemeral 状态，
# 落盘只为"服务重启/刷新不丢确认卡"，无需版本管理。
app/data/pending.json

# 意图样本库：app/agent/intent.py 运行时"每办成一句就学一句"攒下来的，
# 跟 pending.json 同性质（ephemeral 状态）。种子那 7 条**内置在代码里**
# （intent.py 的 _SEED_SAMPLES），所以这个文件删了也能从种子重新长起来。
# 不入库的另一个理由：它会把本机调试时说的话记进去，那是私人语料。
app/data/intent_samples.json

# ===== 模型用量流水（app/llm/gateway.py 每次调用追加一行） =====
# 跟 pending.json 同性质：纯运行时流水，且里面写着**学生的会话 id**，属隐私。
# 管理员想从零计数，在后台「用量统计」卡片点清空即可（不用动文件）。
app/data/llm_usage.jsonl

# 注意：app/data/kb.json 是"入库的种子知识库"，有意保留版本管理，
# 管理员在后台改条目后会出现 diff —— 这是知识内容本身，值得被记录。
app/data/workorders.json
# ===== 驿站低代码：一句话生成的服务定义 + 各服务的登记台账（#18 单子 3） =====
# 与 intent_samples.json 同性质：内置种子写在 store.py 的 _SEED_SERVICES 里，
# 文件删了能重新长出来；驿站管理员现场试出来的句子/学生留的信息不进仓库（隐私 + 噪声）。
app/data/services.json
app/data/custom/

app/data/student_messages.json
server.log
# 本地起 uvicorn 的临时日志（.uvicorn_dev.log / .uvicorn_live.log 等）
.uvicorn*.log

# ===== 端到端截图产物（只是给人看的证据，不入库） =====
tests/_shots/
