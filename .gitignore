# ===== 密钥和本地环境，绝不提交到 git =====
.env
.env.local

# ===== Python 缓存/虚拟环境 =====
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ===== 编辑器/系统垃圾 =====
.idea/
.vscode/
.DS_Store

# ===== 运行时自动生成的数据（学生消息/通知/人格，启动后由 app/store.py 创建） =====
app/data/student_messages.json
app/data/notices.json
# persona.json：管理员在后台配的客服人格，属运行时数据，不入库。
# 默认值写在 app/store.py 的 DEFAULT_PERSONA 里，删掉该文件就自动回到默认值。
app/data/persona.json

# ===== 敏感：管理台在线填的大模型密钥 =====
# settings.json 里可能有真实 API Key，一旦入库就是事故，务必排除。
# 密钥应该走 .env（本地）或 secrets manager（生产），这里只是演示的便利通道。
app/data/settings.json

# ===== 用户上传的文件（可能含私人资料，也不该进 git） =====
app/data/uploads.json
app/data/uploads/

# ===== 学生个人库（周表/待办/会话历史，全是个人隐私到校资料） =====
app/data/student/

# 注意：app/data/kb.json 是"入库的种子知识库"，有意保留版本管理，
# 管理员在后台改条目后会出现 diff —— 这是知识内容本身，值得被记录。
