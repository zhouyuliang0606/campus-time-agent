# ============================================================
# 复制本文件，改名为 .env，然后把你的 Key 填进去
# 注意：.env 已经在 .gitignore 里，不会被提交，密钥安全
# ============================================================

# DeepSeek 大模型密钥（去 https://platform.deepseek.com 注册后获取）
# 形如 sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-在这里填你的真实key

# DeepSeek 接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 用的模型：deepseek-chat 是 V3 通用模型，便宜够用
DEEPSEEK_MODEL=deepseek-chat

# 调试开关：true 时会把 Agent 的"思考过程"打印出来，方便演示
DEBUG=true
